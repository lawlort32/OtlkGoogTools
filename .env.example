# OtlkGoogTools Environment Configuration
# Copy this file to .env and update with your settings

# ============================================
# AUTHENTICATION MODE
# ============================================
# Options: "hybrid" (default), "com", "graph"
# - hybrid: Auto-select between COM and Graph API
# - com: Windows Outlook COM client only
# - graph: Microsoft Graph API only
OTLK_GOOG_AUTH_MODE=hybrid

# ============================================
# PUBLIC CLIENT AUTHENTICATION (NO AZURE REGISTRATION REQUIRED!)
# ============================================
# Use Microsoft's public client applications - zero setup needed!
OTLK_GOOG_USE_PUBLIC_CLIENT=true

# Which public client to use:
# Options: graph-explorer (default), azure-cli, office, powershell, visual-studio
OTLK_GOOG_PUBLIC_CLIENT=graph-explorer

# ============================================
# CUSTOM AZURE AD APPLICATION (OPTIONAL)
# ============================================
# Only needed if you want to use your own Azure AD app instead of public client
# Leave blank to use public client mode

# Your Azure AD Application (Client) ID
OTLK_GOOG_CLIENT_ID=

# Your Azure AD Tenant ID (or "common" for multi-tenant)
OTLK_GOOG_TENANT_ID=common

# Client Secret (only for confidential clients - not recommended for desktop apps)
OTLK_GOOG_CLIENT_SECRET=

# Redirect URI for OAuth callback
OTLK_GOOG_REDIRECT_URI=http://localhost:8400

# ============================================
# MICROSOFT GRAPH API SCOPES
# ============================================
# Permissions needed for Graph API (comma-separated)
# Default scopes are set for public client, customize if using custom app
OTLK_GOOG_GRAPH_SCOPES=https://graph.microsoft.com/Calendars.ReadWrite,https://graph.microsoft.com/Mail.ReadWrite,https://graph.microsoft.com/Mail.Send,https://graph.microsoft.com/User.Read,offline_access

# ============================================
# GOOGLE API CREDENTIALS (OPTIONAL - FOR GOOGLE INTEGRATION)
# ============================================
# Path to Google OAuth2 credentials JSON file
OTLK_GOOG_GOOGLE_CREDENTIALS_FILE=credentials.json

# Google Calendar ID to sync with (default: "primary")
OTLK_GOOG_GOOGLE_CALENDAR_ID=primary

# ============================================
# DATA STORAGE
# ============================================
# Portable mode: Store data in app directory instead of user profile
# Set to "true" for USB/portable installations
OTLK_GOOG_PORTABLE_MODE=false

# Custom user data directory (optional)
# Leave blank to use default: ~/.otlk-goog-tools
OTLK_GOOG_USER_DATA_DIR=

# Token file name (stored in user data directory)
OTLK_GOOG_TOKEN_FILE=microsoft_tokens.json

# ============================================
# LOGGING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
OTLK_GOOG_LOG_LEVEL=INFO

# Log file path (optional - logs to console if not set)
OTLK_GOOG_LOG_FILE=

# ============================================
# MCP SERVER CONFIGURATION
# ============================================
# Server name for MCP registration
OTLK_GOOG_MCP_SERVER_NAME=outlook

# Server version
OTLK_GOOG_MCP_SERVER_VERSION=0.1.0

# ============================================
# CALENDAR SYNC SETTINGS (FUTURE)
# ============================================
# Days to sync in the past
OTLK_GOOG_SYNC_DAYS_PAST=7

# Days to sync in the future
OTLK_GOOG_SYNC_DAYS_FUTURE=30

# Sync interval in minutes
OTLK_GOOG_SYNC_INTERVAL=15

# ============================================
# ADVANCED SETTINGS
# ============================================
# Enable debug mode
OTLK_GOOG_DEBUG=false

# HTTP request timeout (seconds)
OTLK_GOOG_REQUEST_TIMEOUT=30

# Max retries for failed requests
OTLK_GOOG_MAX_RETRIES=3
